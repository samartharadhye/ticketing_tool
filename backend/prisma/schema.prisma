// datasource and client generator
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS (Derived strictly from src/types/index.ts)
// -----------------------------------------------------------------------------

enum IssueType {
  Task
  Bug
  Story
  Epic
  Sub_task @map("Sub-task")
}

enum IssueStatus {
  Open
  To_Do       @map("To Do")
  In_Progress @map("In Progress")
  In_Review   @map("In Review")
  Testing
  Blocked
  Resolved
  Closed
}

enum Priority {
  Lowest
  Low
  Medium
  High
  Highest
}

enum SupportLevel {
  L1
  L2
  L3
}

enum UserRole {
  Admin
  Project_Manager @map("Project Manager")
  Developer
  QA
  Support_Agent   @map("Support Agent")
  Technical
  Engineer
  Viewer
}

enum UserStatus {
  Active
  Away
  Offline
}

enum ProjectStatus {
  Active
  Planning
  Completed
  On_Hold @map("On Hold")
}

enum SprintStatus {
  active
  future
  completed
  planned
}

enum EpicStatus {
  To_Do       @map("To Do")
  In_Progress @map("In Progress")
  Done
}

enum CommentType {
  public
  internal
}

enum NotificationType {
  escalation
  assignment
  comment
  status
  sprint
  system
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String         // bcrypt hashed
  role          UserRole       @default(Viewer)
  department    String
  supportLevels SupportLevel[] @default([L1])
  avatar        String         @default("")
  timezone      String         @default("UTC")
  status        UserStatus     @default(Active)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  assignedIssues        Issue[]              @relation("IssueAssignee")
  reportedIssues        Issue[]              @relation("IssueReporter")
  escalatedRecordsMade  EscalationRecord[]   @relation("EscalatedBy")
  escalatedAssignments  EscalationRecord[]   @relation("EscalatedTo")
  comments              Comment[]
  ledProjects           Project[]            @relation("ProjectLead")
  memberProjects        Project[]            @relation("ProjectMembers")
  activities            ActivityEvent[]
  notifications         Notification[]
  savedFilters          SavedFilter[]
  passwordResetTokens   PasswordResetToken[]

  @@index([role])
  @@index([email])
}

model Project {
  id          String        @id @default(cuid())
  key         String        @unique // e.g. "INB", "CSP"
  name        String
  description String        @default("")
  category    String?       @default("Software")
  leadId      String
  lead        User          @relation("ProjectLead", fields: [leadId], references: [id])
  members     User[]        @relation("ProjectMembers")
  status      ProjectStatus @default(Active)
  createdDate DateTime      @default(now())
  updatedDate DateTime      @updatedAt

  // Relationships
  issues     Issue[]
  sprints    Sprint[]
  epics      Epic[]
  activities ActivityEvent[]

  @@index([key])
  @@index([status])
}

model Sprint {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  startDate     DateTime
  endDate       DateTime
  status        SprintStatus @default(planned)
  goal          String?
  completedDate DateTime?
  createdAt     DateTime     @default(now())

  issues Issue[]

  @@index([projectId, status])
}

model Epic {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String     @default("")
  summary     String?
  color       String     @default("#3b82f6")
  status      EpicStatus @default(To_Do)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())

  issues Issue[]

  @@index([projectId])
}

model Issue {
  id                 String       @id // Format: "INB-1001"
  title              String
  description        String       @default("")
  type               IssueType    @default(Task)
  status             IssueStatus  @default(Open)
  priority           Priority     @default(Medium)
  supportLevel       SupportLevel @default(L1)
  assigneeId         String?
  assignee           User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId         String
  reporter           User         @relation("IssueReporter", fields: [reporterId], references: [id])
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId           String?
  sprint             Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epicId             String?
  epic               Epic?        @relation(fields: [epicId], references: [id], onDelete: SetNull)
  labels             String[]     @default([])
  dueDate            DateTime?
  createdDate        DateTime     @default(now())
  updatedDate        DateTime     @updatedAt
  estimatedTime      String?      // e.g. "4h"
  remainingTime      String?      // e.g. "2h"
  storyPoints        Int?
  responseSLAHours   Float        @default(4.0)
  resolutionSLAHours Float        @default(24.0)
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  isEscalated        Boolean      @default(false)

  // Relationships
  escalationHistory EscalationRecord[]
  comments          Comment[]
  attachments       Attachment[]
  activities        ActivityEvent[]
  notifications     Notification[]

  @@index([projectId, status])
  @@index([supportLevel, status])
  @@index([assigneeId])
  @@index([priority])
  @@index([createdDate])
  @@index([isEscalated])
}

model EscalationRecord {
  id                String       @id @default(cuid())
  issueId           String
  issue             Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  timestamp         DateTime     @default(now())
  fromLevel         SupportLevel
  toLevel           SupportLevel
  reason            String
  escalatedByUserId String
  escalatedByUser   User         @relation("EscalatedBy", fields: [escalatedByUserId], references: [id])
  assignedToUserId  String?
  assignedToUser    User?        @relation("EscalatedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@index([timestamp])
}

model Comment {
  id        String      @id @default(cuid())
  issueId   String
  issue     Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  content   String
  type      CommentType @default(public)
  createdAt DateTime    @default(now())
  updatedAt DateTime?   @updatedAt

  @@index([issueId, type])
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  filename   String
  fileType   String
  fileSize   Int      // bytes
  uploadDate DateTime @default(now())

  @@index([issueId])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  issueId   String?
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())

  @@index([issueId])
  @@index([projectId])
  @@index([timestamp])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(system)
  issueId   String?
  issue     Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model SavedFilter {
  id      String  @id @default(cuid())
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  filters Json

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique  // SHA-256 hex of the raw token
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Settings {
  id                   String   @id @default("singleton")
  appName              String   @default("Inbox")
  tagline              String   @default("Work organized. Teams aligned.")
  workspaceName        String   @default("Acme Global Workspace")
  theme                String   @default("light")
  notificationsEnabled Boolean  @default(true)
  slaSettings          Json     // { l1ResponseHours, l1ResolutionHours, ... }
  notifications        Json     // { issueAssigned, commentAdded, ... }
  preferences          Json     // { defaultIssueView, defaultProjectId, ... }
  slaRules             Json     // { Highest: { responseHours, resolutionHours }, ... }
  rolePageAccess       Json     // Record<AppPageId, UserRole[]>
  updatedAt            DateTime @updatedAt
}